# SPA (Vue Router v režime history): všetky adresy, ktoré nie sú súbor
# ani priečinok, presmeruj na index.html – inak /projects a pod. vrátia 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  # Chýbajúci súbor v /assets/ musí vrátiť 404, nie index.html –
  # inak si cache servera uloží HTML pod adresou JS súboru a web je prázdny.
  RewriteRule ^assets/ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html vždy čerstvý, aby po nasadení hneď odkazoval na nové súbory
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Súbory v /assets/ majú v názve hash obsahu, môžu sa cachovať natrvalo
  <FilesMatch "\.[0-9a-f]{8}\.(js|css|jpg|png|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
